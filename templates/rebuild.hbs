<div class="form-body">
    <p class="hint">{{localize "NJIN.Rebuild.Intro"}}</p>
    <fieldset>
        <label class="njin-radio">
            <input type="radio" name="mode" value="keep" checked>
            <span>
                <strong>{{localize "NJIN.Rebuild.Keep.Name"}}</strong>
                <span class="hint">{{localize "NJIN.Rebuild.Keep.Hint"}}</span>
            </span>
        </label>
        <label class="njin-radio">
            <input type="radio" name="mode" value="defaults">
            <span>
                <strong>{{localize "NJIN.Rebuild.Defaults.Name"}}</strong>
                <span class="hint">{{localize "NJIN.Rebuild.Defaults.Hint"}}</span>
            </span>
        </label>
    </fieldset>
</div>
